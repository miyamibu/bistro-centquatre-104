{
  "name": "bistro-reservation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "check:release": "node scripts/check-release-safety.mjs local-build",
    "check:release:preview": "node scripts/check-release-safety.mjs preview",
    "check:release:production": "node scripts/check-release-safety.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:db": "vitest run tests/*-db.test.ts --maxWorkers=1",
    "preflight": "npm run check:release && npm run lint && npm run test && npm run build",
    "preflight:production": "npm run check:release:production && npm run lint && npm run test && npm run build",
    "qa:user-stories:evidence": "node scripts/export-canonical-user-story-evidence.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "backup:reservations:pull": "tsx scripts/pull-reservation-backups.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:status": "tsx scripts/check-reservation-backup-freshness.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:cleanup": "BACKUP_CLEANUP_ENABLED=false tsx scripts/cleanup-reservation-backups.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:run": "node scripts/run-local-reservation-backup.mjs",
    "backup:reservations": "node scripts/recovery/export-reservation-backup.mjs --out-dir=backups/manual-export-backups",
    "backup:project-snapshot": "bash scripts/recovery/create-project-snapshot.sh",
    "backup:workspace:snapshot": "node scripts/run-local-safety-backups.mjs",
    "security:env": "node scripts/security/check-env-permissions.mjs",
    "security:destructive": "node scripts/security/check-destructive-reservation-queries.mjs",
    "security:destructive-reservations": "node scripts/security/check-destructive-reservation-queries.mjs",
    "add": "liftkit add",
    "convert:pdf": "tsx batch-convert-pdf.mts"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@line/liff": "^2.28.0",
    "@material/material-color-utilities": "^0.4.0",
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.97.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.0.0",
    "glob": "^13.0.6",
    "lucide-react": "^0.446.0",
    "next": "^15.5.20",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "resend": "^6.14.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.15",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@react-email/render": "^2.0.4",
    "axios": "^1.18.0",
    "diff": "^4.0.4",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "js-yaml": "^4.2.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    },
    "picomatch": "^2.3.2",
    "rollup": "^4.62.2",
    "tinyglobby": {
      "picomatch": "^4.0.4"
    }
  }
}
