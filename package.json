{
  "name": "bistro-reservation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "guard:noncanonical": "node scripts/guard-noncanonical-execution.mjs",
    "dev": "npm run guard:noncanonical -- --operation=dev && next dev",
    "build": "npm run guard:noncanonical -- --operation=build && prisma generate && next build",
    "start": "npm run guard:noncanonical -- --operation=start && next start",
    "postinstall": "prisma generate",
    "check:release": "npm run guard:noncanonical -- --operation=check:release && node scripts/check-release-safety.mjs local-build",
    "check:release:preview": "npm run guard:noncanonical -- --operation=check:release:preview && node scripts/check-release-safety.mjs preview",
    "check:release:production": "npm run guard:noncanonical -- --operation=check:release:production && node scripts/check-release-safety.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/*-db.test.ts --maxWorkers=1",
    "preflight": "npm run guard:noncanonical -- --operation=preflight && npm run check:release && npm run lint && npm run test && npm run build",
    "prisma:migrate": "npm run guard:noncanonical -- --operation=prisma:migrate && prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "npm run guard:noncanonical -- --operation=prisma:seed && tsx prisma/seed.ts",
    "backup:reservations:pull": "npm run guard:noncanonical -- --operation=backup:pull && tsx scripts/pull-reservation-backups.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:cleanup": "npm run guard:noncanonical -- --operation=backup:cleanup && tsx scripts/cleanup-reservation-backups.ts --out-dir=backups/reservation-daily-backups --dry-run=true",
    "backup:reservations:run": "npm run guard:noncanonical -- --operation=backup:run && node scripts/run-local-reservation-backup.mjs",
    "backup:reservations": "npm run guard:noncanonical -- --operation=backup:export && node scripts/recovery/export-reservation-backup.mjs --out-dir=backups/manual-export-backups",
    "backup:project-snapshot": "npm run guard:noncanonical -- --operation=backup:project-snapshot && bash scripts/recovery/create-project-snapshot.sh",
    "backup:workspace:snapshot": "npm run guard:noncanonical -- --operation=backup:workspace:snapshot && node scripts/run-local-safety-backups.mjs",
    "security:env": "node scripts/security/check-env-permissions.mjs",
    "security:destructive": "node scripts/security/check-destructive-reservation-queries.mjs",
    "security:destructive-reservations": "node scripts/security/check-destructive-reservation-queries.mjs",
    "add": "liftkit add",
    "convert:pdf": "tsx batch-convert-pdf.mts"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@line/liff": "^2.28.0",
    "@material/material-color-utilities": "^0.4.0",
    "@prisma/client": "^5.19.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.97.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.0.0",
    "glob": "^13.0.6",
    "lucide-react": "^0.446.0",
    "next": "^15.5.19",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "resend": "^6.14.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.3",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@react-email/render": "^2.0.4"
  }
}
