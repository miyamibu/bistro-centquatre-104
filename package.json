{
  "name": "bistro-reservation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma-client.mjs && next build",
    "build:cloudflare": "CLOUDFLARE_WORKER_RUNTIME=true opennextjs-cloudflare build && node scripts/bundle-cloudflare-functions.mjs",
    "preview:cloudflare": "CLOUDFLARE_WORKER_RUNTIME=true opennextjs-cloudflare preview",
    "deploy:cloudflare": "node scripts/deploy-cloudflare-workers.mjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "check:release": "node scripts/check-release-safety.mjs local-build",
    "check:release:preview": "node scripts/check-release-safety.mjs preview",
    "check:release:production": "node scripts/check-release-safety.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:db": "node scripts/run-safe-db-tests.mjs",
    "test:db:runner": "vitest run tests/*-db.test.ts --maxWorkers=1",
    "preflight": "npm run check:release && npm run lint && npm run typecheck && npm run security:env && npm run security:destructive && npm run test && npm run build",
    "preflight:production": "npm run check:release:production && npm run lint && npm run typecheck && npm run security:env && npm run security:destructive && npm run test && npm run build",
    "qa:user-stories:evidence": "node scripts/export-canonical-user-story-evidence.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "backup:reservations:pull": "tsx scripts/pull-reservation-backups.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:status": "tsx scripts/check-reservation-backup-freshness.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:cleanup": "BACKUP_CLEANUP_ENABLED=false tsx scripts/cleanup-reservation-backups.ts --out-dir=backups/reservation-daily-backups",
    "backup:reservations:run": "node scripts/run-local-reservation-backup.mjs",
    "backup:reservations": "node scripts/recovery/export-reservation-backup.mjs --out-dir=backups/manual-export-backups",
    "backup:database:safety-dump": "node scripts/recovery/create-encrypted-db-dump.mjs",
    "backup:restore-drill": "node scripts/backup-restore-drill.mjs",
    "staff:provision": "node scripts/provision-staff.mjs",
    "backup:project-snapshot": "bash scripts/recovery/create-project-snapshot.sh",
    "backup:workspace:snapshot": "node scripts/run-local-safety-backups.mjs",
    "backup:workspace:status": "node scripts/check-workspace-bundle-provenance.mjs",
    "security:env": "node scripts/security/check-env-permissions.mjs",
    "security:destructive": "node scripts/security/check-destructive-reservation-queries.mjs",
    "security:destructive-reservations": "node scripts/security/check-destructive-reservation-queries.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "add": "liftkit add",
    "convert:pdf": "tsx batch-convert-pdf.mts"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@line/liff": "^2.28.0",
    "@material/material-color-utilities": "^0.4.0",
    "@opentelemetry/api": "1.9.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.97.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.0.0",
    "glob": "^13.0.6",
    "lucide-react": "^0.446.0",
    "next": "^15.5.20",
    "pdf-parse": "^2.4.5",
    "pg": "8.16.3",
    "puppeteer": "^25.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "resend": "^6.14.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.5",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.3",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@react-email/render": "^2.0.4",
    "axios": "^1.18.0",
    "diff": "^4.0.4",
    "deepmerge-ts": "8.0.2",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.1",
    "minimatch": "10.2.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "10.2.6"
    },
    "picomatch": "^2.3.2",
    "rollup": "^4.62.2",
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "nanoid": "^3.3.18",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
