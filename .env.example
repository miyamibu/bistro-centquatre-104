# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro
# Prisma direct connection URL (required; use the same database without a pooler)
DIRECT_URL=
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro_test

# App base URL
BASE_URL=https://example.com

# Admin authentication (Supabase Auth; create individual users and set app_metadata.role)
STAFF_SESSION_MAX_AGE_SECONDS=28800
SELF_SERVICE_CANCELLATION_CUTOFF_HOURS=24

# Notification / mail
STORE_NOTIFY_EMAIL=staff@example.com
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-email-api-key
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=no-reply@example.com
ADMIN_EMAIL=staff@example.com
STORE_NAME=Bistro 104

# LINE (optional)
# LINE Login / LIFF / Messaging API は必ず同一の LINE Developers Provider 配下で作成する。
# 別Provider配下だと userId の発行軸が変わり、ID token の sub を Push API 宛先として使えなくなる。
#
# Production requirement: LINE が有効（LINE_CHANNEL_ACCESS_TOKEN 等を設定）な場合、
# 以下の全 env が必須。欠けがあると起動時に fail-fast エラーになる。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
#
# LIFF IDs (LINE Developers Console > LIFF タブで取得)
# Booking LIFF endpoint : https://本番ドメイン/booking   size=Full  scopes=openid profile
# Link LIFF endpoint    : https://本番ドメイン/line/link  size=Full  scopes=openid profile
NEXT_PUBLIC_LIFF_BOOKING_ID=
NEXT_PUBLIC_LIFF_LINK_ID=
# Deprecated: NEXT_PUBLIC_LIFF_ID は移行期間のみ fallback として動作する。新規設定不要。
# NEXT_PUBLIC_LIFF_ID=
#
# Token security (本番: 32 文字以上のランダム文字列必須)
LINE_LINK_TOKEN_PEPPER=replace-with-32-char-minimum-random-secret
#
# Monthly notification limit (default: LINE free tier 200 / warn at 180)
LINE_MONTHLY_REMINDER_LIMIT=200
LINE_MONTHLY_REMINDER_WARN_THRESHOLD=180

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Cron / backup security tokens
CRON_SECRET=replace-with-strong-random-token
BACKUP_EXPORT_SECRET=replace-with-strong-backup-export-token
BACKUP_ENCRYPTION_KEY=replace-with-32-char-minimum-backup-encryption-key
# BACKUP_ENCRYPTION_KEY_ID=v1
# Rotation format: {"v1":"...","v2":"..."}; keep old keys until all backup files are migrated.
# BACKUP_ENCRYPTION_KEYS_JSON=
# BACKUP_ENCRYPTION_ACTIVE_KEY_ID=v1
RATE_LIMIT_HASH_SECRET=replace-with-32-char-minimum-rate-limit-secret
RESERVATION_TOKEN_SECRET=replace-with-32-char-minimum-reservation-token-secret
# Rotation format: {"v1":"...","v2":"..."}; keep old keys until token TTL expires.
# RESERVATION_TOKEN_KEYS_JSON=
# RESERVATION_TOKEN_ACTIVE_KEY_ID=v1

# Local backup destination (outside repo)
BISTRO_BACKUP_DIR=backups/reservation-daily-backups
BACKUP_OUTPUT_DIR=backups/reservation-daily-backups
BACKUP_BASE_URL=https://example.com

# Admin passcode required to unlock private-block mode from the public booking page
PRIVATE_BLOCK_ACCESS_CODE=replace-with-strong-private-block-passcode

# Bank account history encryption (server-side only)
BANK_ACCOUNT_HISTORY_ENCRYPTION_KEY=replace-with-32-byte-random-secret
BANK_ACCOUNT_HISTORY_KEY_VERSION=1

# Contact information
CONTACT_PHONE_E164=+810000000000
CONTACT_PHONE_DISPLAY=00-0000-0000
CONTACT_MESSAGE=お電話でお問い合わせください

# Public contact values used by client components
NEXT_PUBLIC_CONTACT_PHONE_E164=+810000000000
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=00-0000-0000
NEXT_PUBLIC_CONTACT_MESSAGE=お電話でお問い合わせください
