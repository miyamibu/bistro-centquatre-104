# Database
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro_test

# App base URL
BASE_URL=https://example.com

# Admin authentication
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change-me

# Notification / mail
STORE_NOTIFY_EMAIL=staff@example.com
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace-with-email-api-key
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=no-reply@example.com
ADMIN_EMAIL=staff@example.com
STORE_NAME=Bistro 104

# LINE (optional)
# LINE Login / LIFF / Messaging API は必ず同一の LINE Developers Provider 配下で作成する。
# 別Provider配下だと userId の発行軸が変わり、ID token の sub を Push API 宛先として使えなくなる。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Cron / backup security tokens
CRON_SECRET=replace-with-strong-random-token
BACKUP_EXPORT_SECRET=replace-with-strong-backup-export-token

# Local backup destination (outside repo)
BISTRO_BACKUP_DIR=backups/reservation-daily-backups
BACKUP_OUTPUT_DIR=backups/reservation-daily-backups
BACKUP_BASE_URL=https://example.com

# Admin passcode required to unlock private-block mode from the public booking page
PRIVATE_BLOCK_ACCESS_CODE=replace-with-strong-private-block-passcode

# Bank account history encryption (server-side only)
BANK_ACCOUNT_HISTORY_ENCRYPTION_KEY=replace-with-32-byte-random-secret
BANK_ACCOUNT_HISTORY_KEY_VERSION=1

# Contact information
CONTACT_PHONE_E164=+810000000000
CONTACT_PHONE_DISPLAY=00-0000-0000
CONTACT_MESSAGE=お電話でお問い合わせください

# Public contact values used by client components
NEXT_PUBLIC_CONTACT_PHONE_E164=+810000000000
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=00-0000-0000
NEXT_PUBLIC_CONTACT_MESSAGE=お電話でお問い合わせください
