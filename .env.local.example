DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro
TEST_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/bistro_test
ALLOW_DESTRUCTIVE_TEST_DB=1
BASE_URL=http://127.0.0.1:3000
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=changeme
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
CRON_SECRET=dummy-cron-secret
BACKUP_EXPORT_SECRET=dummy-backup-export-secret
RATE_LIMIT_HASH_SECRET=dev-rate-limit-hash-secret-32chars
BACKUP_OUTPUT_DIR=backups/reservation-daily-backups
BISTRO_BACKUP_DIR=backups/reservation-daily-backups
PRIVATE_BLOCK_ACCESS_CODE=change-me-private-block-code
BANK_ACCOUNT_HISTORY_ENCRYPTION_KEY=dummy-bank-history-key
BANK_ACCOUNT_HISTORY_KEY_VERSION=1

# LINE (optional for local dev — set only if exercising the LIFF/Push flow).
# All channels must live under the same LINE Developers Provider.
# See docs/line-reminder-production-setup.md for full setup guide.
#
# LIFF IDs:
#   Booking LIFF → /booking   (size=Full, scopes=openid profile)
#   Link LIFF    → /line/link (size=Full, scopes=openid profile)
NEXT_PUBLIC_LIFF_BOOKING_ID=
NEXT_PUBLIC_LIFF_LINK_ID=
# Deprecated fallback — use NEXT_PUBLIC_LIFF_BOOKING_ID / NEXT_PUBLIC_LIFF_LINK_ID instead.
# NEXT_PUBLIC_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LINK_TOKEN_PEPPER=dev-line-link-token-pepper-32chars-pad
LINE_MONTHLY_REMINDER_LIMIT=200
LINE_MONTHLY_REMINDER_WARN_THRESHOLD=180

# Optional but recommended for browser-visible contact information
NEXT_PUBLIC_CONTACT_PHONE_E164=+81492706897
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=049－270－6897
NEXT_PUBLIC_CONTACT_MESSAGE=お電話でお問い合わせください
