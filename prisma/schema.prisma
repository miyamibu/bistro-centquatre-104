// Prisma schema for Bistro reservation system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SeatType {
  MAIN
  ROOM1
  ROOM2
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  DONE
  NOSHOW
}

enum ReservationType {
  NORMAL
  PRIVATE_BLOCK
}

enum ServicePeriod {
  LUNCH
  DINNER
}

enum PrivateBlockAuditResult {
  CREATED
  NO_OP
  RELEASED
}

enum PrivateBlockAuditSource {
  PUBLIC_FORM
  ADMIN_SHARED_BASIC
}

enum DailyJournalStatus {
  DRAFT
  PUBLISHED
}

model Reservation {
  id                    String                 @id @default(cuid())
  date                  String
  servicePeriod         ServicePeriod
  reservationType       ReservationType        @default(NORMAL)
  seatType              SeatType
  partySize             Int
  arrivalTime           String?
  name                  String
  phone                 String
  note                  String?
  status                  ReservationStatus      @default(CONFIRMED)
  lineUserId              String?
  lineReminderSentAt      DateTime?
  lineReminderStatus      String?
  lineReminderError       String?
  lineClaimTokenHash      String?
  lineClaimExpiresAt      DateTime?
  lineConfirmationSentAt  DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  privateBlockAuditLogs   PrivateBlockAuditLog[]
  statusAuditLogs         ReservationStatusAuditLog[]

  @@index([date, servicePeriod])
  @@index([date, servicePeriod, reservationType])
  @@index([lineReminderSentAt])
}

model ReservationStatusAuditLog {
  id             String            @id @default(cuid())
  reservationId  String
  reservation    Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  actorName      String?
  requestId      String
  ipAddress      String?
  userAgent      String?
  previousStatus ReservationStatus
  nextStatus     ReservationStatus
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([reservationId, createdAt])
  @@index([createdAt])
}

model PrivateBlockAuditLog {
  id            String                  @id @default(cuid())
  reservationId String?
  reservation   Reservation?            @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  date          String
  servicePeriod ServicePeriod
  result        PrivateBlockAuditResult
  source        PrivateBlockAuditSource
  actorName     String?
  requestId     String
  ipAddress     String?
  userAgent     String?
  note          String?
  createdAt     DateTime                @default(now())

  @@index([date, servicePeriod, createdAt])
  @@index([reservationId, createdAt])
}

model ReservationRateLimitEvent {
  id            String         @id @default(cuid())
  keyHash       String
  scope         String
  date          String?
  servicePeriod ServicePeriod?
  createdAt     DateTime       @default(now())

  @@index([keyHash, scope, createdAt])
  @@index([date, servicePeriod, scope, createdAt])
}

model BusinessDay {
  id       String  @id @default(cuid())
  date     String  @unique
  isClosed Boolean @default(false)
  note     String?
}

model MenuItem {
  id          String  @id @default(cuid())
  title       String
  description String
  price       Int
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model Photo {
  id          String  @id @default(cuid())
  url         String
  caption     String
  category    String  @default("food")
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model DailyJournalEntry {
  id        String             @id @default(cuid())
  date      String
  title     String
  category  String
  body      String
  photoUrl  String?
  status    DailyJournalStatus @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, date, updatedAt])
  @@index([date, updatedAt])
}
