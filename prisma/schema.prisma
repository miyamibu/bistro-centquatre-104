// Prisma schema for Bistro reservation system

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SeatType {
  MAIN
  ROOM1
  ROOM2
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  DONE
  NOSHOW
}

enum ReservationType {
  NORMAL
  PRIVATE_BLOCK
}

enum ServicePeriod {
  LUNCH
  DINNER
}

enum ReservationContactChannel {
  EMAIL
  LINE
}

enum PrivateBlockAuditResult {
  CREATED
  NO_OP
  RELEASED
}

enum PrivateBlockAuditSource {
  PUBLIC_FORM
  ADMIN_USER
}

enum DailyJournalStatus {
  DRAFT
  PUBLISHED
}

enum ReservationEmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  DEAD_LETTER
}

enum ReservationEmailNotificationType {
  RESERVATION_CONFIRMATION
  CUSTOMER_CONFIRMATION
  RESERVATION_CANCELLED_CUSTOMER
  RESERVATION_NOSHOW_CUSTOMER
}

enum LineWebhookInboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Reservation {
  id                           String                          @id @default(cuid())
  date                         String
  servicePeriod                ServicePeriod
  reservationType              ReservationType                 @default(NORMAL)
  seatType                     SeatType
  partySize                    Int
  arrivalTime                  String?
  name                         String
  phone                        String
  customerEmail                String?
  customerEmailVerifiedAt      DateTime?
  contactChannel               ReservationContactChannel?
  note                         String?
  status                       ReservationStatus               @default(CONFIRMED)
  cancellationPolicyVersion    String?
  cancellationPolicyAcceptedAt DateTime?
  cancelledAt                  DateTime?
  cancelSource                 String?
  cancellationReason           String?
  lineUserId                   String?
  lineReminderSentAt           DateTime?
  lineReminderStatus           String?
  lineReminderError            String?
  lineClaimTokenHash           String?
  lineClaimExpiresAt           DateTime?
  lineConfirmationSentAt       DateTime?
  lineLinkedAt                 DateTime?
  lineLinkSource               String?
  linePushStatus               String?
  linePushCheckedAt            DateTime?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  privateBlockAuditLogs        PrivateBlockAuditLog[]
  statusAuditLogs              ReservationStatusAuditLog[]
  lineLinkTokens               ReservationLineLinkToken[]
  managementTokens             ReservationManagementToken[]
  notificationEvents           NotificationEvent[]
  emailOutboxEntries           ReservationEmailOutbox[]
  idempotencyRecords           ReservationIdempotency[]
  correctionAuditLogs          ReservationCorrectionAuditLog[]

  @@index([date, servicePeriod])
  @@index([date, servicePeriod, reservationType])
  @@index([lineReminderSentAt])
}

model ReservationEmailOutbox {
  id                     String                           @id @default(cuid())
  reservationId          String
  notificationType       ReservationEmailNotificationType
  status                 ReservationEmailOutboxStatus     @default(PENDING)
  attempts               Int                              @default(0)
  maxAttempts            Int                              @default(5)
  nextAttemptAt          DateTime?                        @default(now())
  claimedAt              DateTime?
  lockedUntil            DateTime?
  claimToken             String?
  sentAt                 DateTime?
  providerMessageId      String?
  providerIdempotencyKey String?
  lastError              String?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  reservation            Reservation                      @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, notificationType])
  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([createdAt])
}

model ReservationIdempotency {
  idempotencyKey String       @unique
  id             String       @id @default(cuid())
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  reservationId  String?
  tokenKeyId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([createdAt])
}

model ReservationStatusAuditLog {
  id             String            @id @default(cuid())
  reservationId  String
  reservation    Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorName      String?
  actorUserId    String?
  actorEmail     String?
  actorRole      String?
  operatorLabel  String?
  requestId      String
  ipAddress      String?
  userAgent      String?
  previousStatus ReservationStatus
  nextStatus     ReservationStatus
  reason         String?
  createdAt      DateTime          @default(now())

  @@index([reservationId, createdAt])
  @@index([createdAt])
}

model ReservationLineLinkToken {
  id            String      @id @default(cuid())
  reservationId String
  tokenHash     String      @unique
  keyId         String      @default("v1")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([expiresAt])
}

model ReservationManagementToken {
  id            String      @id @default(cuid())
  reservationId String
  tokenHash     String      @unique
  keyId         String      @default("v1")
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([expiresAt])
}

model LineFriend {
  lineUserId       String    @id
  friendshipStatus String
  followedAt       DateTime?
  unfollowedAt     DateTime?
  lastEventAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LineWebhookInbox {
  id          String                 @id @default(cuid())
  eventId     String                 @unique
  eventType   String
  payload     Json
  status      LineWebhookInboxStatus @default(PENDING)
  attempts    Int                    @default(0)
  claimedAt   DateTime?
  lockedUntil DateTime?
  claimToken  String?
  processedAt DateTime?
  lastError   String?
  requestId   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, lockedUntil])
  @@index([createdAt])
}

model NotificationEvent {
  id            String      @id @default(cuid())
  reservationId String
  channel       String
  type          String
  targetDate    String
  status        String      @default("PENDING")
  retryKey      String      @unique
  claimedAt     DateTime?
  claimToken    String?
  sentAt        DateTime?
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, channel, type, targetDate])
  @@index([status, targetDate])
}

model LineCustomerLink {
  id                  String   @id @default(cuid())
  lineUserId          String
  normalizedPhoneHash String
  consentedAt         DateTime
  lastLinkedAt        DateTime
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([lineUserId, normalizedPhoneHash])
  @@index([normalizedPhoneHash])
}

model PrivateBlockAuditLog {
  id            String                  @id @default(cuid())
  reservationId String?
  reservation   Reservation?            @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  date          String
  servicePeriod ServicePeriod
  result        PrivateBlockAuditResult
  source        PrivateBlockAuditSource
  actorName     String?
  actorUserId   String?
  actorEmail    String?
  actorRole     String?
  operatorLabel String?
  requestId     String
  ipAddress     String?
  userAgent     String?
  note          String?
  createdAt     DateTime                @default(now())

  @@index([date, servicePeriod, createdAt])
  @@index([reservationId, createdAt])
}

model ReservationRateLimitEvent {
  id            String         @id @default(cuid())
  keyHash       String
  scope         String
  date          String?
  servicePeriod ServicePeriod?
  createdAt     DateTime       @default(now())

  @@index([keyHash, scope, createdAt])
  @@index([date, servicePeriod, scope, createdAt])
}

model BusinessDay {
  id        String                @id @default(cuid())
  date      String                @unique
  isClosed  Boolean               @default(false)
  note      String?
  auditLogs BusinessDayAuditLog[]
}

model BusinessDayAuditLog {
  id               String      @id @default(cuid())
  businessDayId    String
  businessDay      BusinessDay @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  date             String
  previousIsClosed Boolean?
  nextIsClosed     Boolean
  previousNote     String?
  nextNote         String?
  actorName        String?
  actorUserId      String?
  actorEmail       String?
  actorRole        String?
  requestId        String
  ipAddress        String?
  userAgent        String?
  reason           String?
  createdAt        DateTime    @default(now())

  @@index([date, createdAt])
  @@index([businessDayId, createdAt])
}

model ReservationCorrectionAuditLog {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorName     String?
  actorUserId   String?
  actorEmail    String?
  actorRole     String?
  requestId     String
  ipAddress     String?
  userAgent     String?
  reason        String
  beforeData    Json
  afterData     Json
  createdAt     DateTime    @default(now())

  @@index([reservationId, createdAt])
  @@index([createdAt])
}

model SchedulerHeartbeat {
  id                 String    @id @default(cuid())
  schedulerKind      String
  lane               String
  lastStartedAt      DateTime
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  processedCount     Int       @default(0)
  retryCount         Int       @default(0)
  deadLetterCount    Int       @default(0)
  backlogCount       Int       @default(0)
  oldestBacklogAt    DateTime?
  lastRunId          String?
  lastProviderCronAt DateTime?
  immediateAttempts  Int       @default(0)
  immediateSuccesses Int       @default(0)
  lastErrorCode      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([schedulerKind, lane])
  @@index([lane, updatedAt])
}

model OutboxDrainAuditLog {
  id              String   @id @default(cuid())
  actorUserId     String
  actorEmail      String?
  actorRole       String
  requestId       String
  lane            String
  dryRun          Boolean
  requestedLimit  Int
  scannedCount    Int
  sentCount       Int
  failedCount     Int
  deadLetterCount Int
  backlogCount    Int
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

model MenuItem {
  id          String  @id @default(cuid())
  title       String
  description String
  price       Int
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model Photo {
  id          String  @id @default(cuid())
  url         String
  caption     String
  category    String  @default("food")
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

model DailyJournalEntry {
  id        String             @id @default(cuid())
  date      String
  title     String
  category  String
  body      String
  photoUrl  String?
  status    DailyJournalStatus @default(DRAFT)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, date, updatedAt])
  @@index([date, updatedAt])
}
